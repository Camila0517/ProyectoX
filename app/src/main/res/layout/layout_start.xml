<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/fondo_suave">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/logo_giru"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/giru_logo"
        app:shapeAppearanceOverlay="@style/CircleImage"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestión Integral de Residuos Urbanos"
        android:textColor="@color/giru_green"
        android:textSize="20sp"
        android:textStyle="bold|italic"
        android:alpha="0.8"
        android:layout_marginBottom="60dp"
        android:textAlignment="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_to_login"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Iniciar Sesión"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/giru_green"
        app:cornerRadius="32dp"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_to_register"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Crear Cuenta"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/giru_green"
        app:cornerRadius="32dp" />

</LinearLayout>