<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@color/fondo_suave"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tv_welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Bienvenido a GIRU!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/giru_green"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mantén tu comunidad limpia hoy."
        android:textSize="16sp"
        android:textColor="#757575"
        android:layout_marginBottom="60dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_new_post"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="NUEVA PUBLICACIÓN"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:backgroundTint="@color/giru_green"
        app:cornerRadius="32dp"
        app:icon="@android:drawable/ic_menu_add"
        app:iconGravity="textStart"
        android:layout_marginBottom="20dp" />

</LinearLayout>